# /etc/nginx/sites-available/pocketoption  (symlink into sites-enabled)
# App is deployed by deploy.sh to /var/www/pocketoption and served by PM2 on 127.0.0.1:3001.
# Run `certbot --nginx -d pocketoption.lc -d www.pocketoption.lc` after DNS points here;
# certbot adds the 443 server block and the HTTP -> HTTPS redirect.

server {
    listen 80;
    listen [::]:80;
    server_name pocketoption.lc www.pocketoption.lc;

    if ($host = www.pocketoption.lc) {
        return 301 $scheme://pocketoption.lc$request_uri;
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;

    location /_next/static/ {
        alias /var/www/pocketoption/.next/static/;
        expires 1y;
        access_log off;
        add_header Cache-Control "public, immutable";
    }

    location /images/ {
        alias /var/www/pocketoption/public/images/;
        expires 30d;
        access_log off;
        add_header Cache-Control "public, max-age=2592000";
    }

    location / {
        proxy_pass         http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection 'upgrade';
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
